// zakki 中継サーバ Worker（issue #134）。
//
// 静的資産（SPA）は Workers Assets で配る。
//
// 前提: `just setup-web`（vite build）で dist/ を作っておく。
// デプロイ: `bun run --cwd apps/web deploy`（= wrangler deploy --env production）。
// 手順は docs/MULTIUSER.md。
{
  "name": "zakki-web",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-07-01",
  // libSQL クライアント（@libsql/client/web）と封筒の blob 書き込みが node の Buffer を
  // 使うため。Workers の互換レイヤで賄える範囲（ファイルシステムは使わない。
  // depcruise の web-worker-portable が到達しないことを縛っている）
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // vite build の出力
    "directory": "dist",
    // SPA なので、資産に無いパスは index.html を返す（クライアントルータが解釈する）
    "not_found_handling": "single-page-application",
    // /api/* だけは Worker を先に通す。それ以外は Assets が直接応答し、
    // Worker の実行（と課金）が発生しない
    "run_worker_first": ["/api/*"],
  },
  // コントロールプレーン（apps/api）への Worker → Worker 直結（issue #134）。
  // 公開 URL で fetch するとループバックして自分の SPA フォールバックを掴むため、
  // サーバ側の問い合わせは必ずこの binding を通す。service 名は apps/api の
  // env.production.name と一致させる。
  "services": [{ "binding": "CONTROL_PLANE", "service": "zakki-api-prod" }],
  "r2_buckets": [
    { "binding": "FILES_PERMANENT", "bucket_name": "zakki-files-permanent-prod" },
    { "binding": "FILES_1D", "bucket_name": "zakki-files-1d-prod" },
    { "binding": "FILES_7D", "bucket_name": "zakki-files-7d-prod" },
    { "binding": "FILES_30D", "bucket_name": "zakki-files-30d-prod" },
  ],
  // 非機密の設定。値は空にしてある: 埋めずに `wrangler dev` すると env 検証が
  // 即座に落ちて設定漏れに気づける（apps/api/wrangler.jsonc と同じ方針）。
  //   ZAKKI_CONTROL_PLANE_URL  apps/api の base URL。**ブラウザが直接叩く**ための公開 URL で、
  //                            GET /api/config が返す。サーバ側の呼び出しは上の binding を使う
  "vars": {
    "ZAKKI_CONTROL_PLANE_URL": "",
  },
  "env": {
    // 本番。services / vars は env へ継承されないので書き直す。
    // vars を空にしてあるのは apps/api/wrangler.jsonc と同じ理由: apps/api の URL は
    // アカウント固有の workers.dev サブドメインを含むので公開リポジトリに置かず、
    // gitignore された `.deploy.production.env` から `--secrets-file` で渡す
    "production": {
      "name": "zakki-web",
      "services": [{ "binding": "CONTROL_PLANE", "service": "zakki-api-prod" }],
      "r2_buckets": [
        { "binding": "FILES_PERMANENT", "bucket_name": "zakki-files-permanent-prod" },
        { "binding": "FILES_1D", "bucket_name": "zakki-files-1d-prod" },
        { "binding": "FILES_7D", "bucket_name": "zakki-files-7d-prod" },
        { "binding": "FILES_30D", "bucket_name": "zakki-files-30d-prod" },
      ],
      "vars": {},
    },
  },
}
